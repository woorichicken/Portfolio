// Cloudflare Workers 설정 — solhun.com 포트폴리오(OpenNext).
// 2026-11-09 운영 자원·도메인 연결 끝 — 자원 id·트리거·되돌리기는 docs/DEPLOY.md 8절.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solhun-portfolio",
  "main": ".open-next/worker.js",
  "account_id": "4521ed2f6bd35977301d9344ffcbbc8e",
  // workerd 1.20261104 이 아는 날짜 안에서 고른다
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    // OpenNext 캐시가 자기 자신을 부를 때 쓴다 — 이름이 Worker 이름과 같아야 한다
    { "binding": "WORKER_SELF_REFERENCE", "service": "solhun-portfolio" }
  ],
  "d1_databases": [
    // 본문(ko·en·es)·역할 순서·숨김·이력·미디어 목록. 스키마는 migrations/
    {
      "binding": "DB",
      "database_name": "solhun-portfolio",
      "database_id": "e19ff0c9-85cd-4c53-aaa0-aa73b987ddb3",
      "migrations_dir": "migrations"
    },
    // OpenNext 태그 캐시(revalidatePath·revalidateTag) — 같은 DB 를 다른 이름으로 한 번 더 묶는다
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "solhun-portfolio",
      "database_id": "e19ff0c9-85cd-4c53-aaa0-aa73b987ddb3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // 다 그린 페이지 캐시(OpenNext incremental cache)
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "solhun-portfolio-cache" },
    // 어드민·API 로 올린 사진·영상 — /media/<key> 로 내보낸다
    { "binding": "MEDIA", "bucket_name": "solhun-portfolio-media" }
  ],
  // next/image 최적화. 없으면 원본을 그대로 내보낸다(OpenNext images.js)
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // 2026-11-09 Vercel → Workers 전환. 도메인은 API 로 먼저 붙였고(배치 cutover.sh), 다음 배포가 떼지 않게 여기에도 적는다.
  // routes 를 적으면 Wrangler 가 workers.dev 를 기본으로 끄므로 명시해서 유지한다(검증·비상용 주소)
  "workers_dev": true,
  "routes": [
    { "pattern": "www.solhun.com", "custom_domain": true },
    { "pattern": "solhun.com", "custom_domain": true }
  ]
}
